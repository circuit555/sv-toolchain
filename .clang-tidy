


# NOTE: somehow clangd-v20.1.2 does not like bugprone-* checks. Would be nice to enable them back again!
Checks: >-
  modernize-*, 
  performance-*, 
  readability-*, 
  clang-analyzer-*, 
  misc-*, 
  portability-*, 
  cppcoreguidelines-*,
  -readability-identifier-length,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -misc-no-recursion
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 40
